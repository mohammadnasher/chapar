<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Welcome to {{appName}}</title>
</head>
<body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h1>Welcome, {{name}}!</h1>
  <p>Thank you for joining <strong>{{appName}}</strong>. We're thrilled to have you.</p>
  {{#if actionUrl}}
  <p>
    <a href="{{actionUrl}}" style="background:#2563eb;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;">
      Get Started
    </a>
  </p>
  {{/if}}
  <hr>
  <small>&copy; {{currentYear}} {{appName}}. All rights reserved.</small>
</body>
</html>
