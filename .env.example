# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chapar:secret@localhost:5432/chapar
POSTGRES_DB=chapar
POSTGRES_USER=chapar
POSTGRES_PASSWORD=secret

# ── Redis (BullMQ) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://:secret@localhost:6379
REDIS_PASSWORD=secret

# ── Security ────────────────────────────────────────────────────────────────────
# Generate: node -e "const b=require('bcrypt');b.hash('YOUR_KEY',12).then(console.log)"
API_KEY_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_API_KEY

# ── Rate Limiting ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── KavehNegar (SMS) ───────────────────────────────────────────────────────────
KAVEHNEGAR_API_KEY=

# ── SMTP (Email) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Push Notifications ─────────────────────────────────────────────────────────
# Set to true to use Firebase FCM; false to use Redis Pub/Sub in-app notifications
FIREBASE_NOTIFICATION=false

# Firebase (required when FIREBASE_NOTIFICATION=true)
# Generate: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_CREDENTIALS_JSON=

# Redis Pub/Sub (required when FIREBASE_NOTIFICATION=false)
REDIS_PUBSUB_URL=redis://:secret@localhost:6379
REDIS_PUBSUB_CHANNEL_PREFIX=notifications
