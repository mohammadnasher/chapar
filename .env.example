# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Role this process runs as: 'api' (HTTP only), 'worker' (queue consumer only),
# or 'all' (both — handy for local dev). docker-compose sets 'api'/'worker'.
CHAPAR_ROLE=all

# ── Database ───────────────────────────────────────────────────────────────────
# NOTE: localhost is for local dev (pnpm start:dev). Under docker-compose the
# DATABASE_URL / REDIS_URL / REDIS_PUBSUB_URL are set automatically to the
# service names (postgres, redis), so these host values are overridden there.
DATABASE_URL=postgresql://chapar:secret@localhost:5432/chapar
POSTGRES_DB=chapar
POSTGRES_USER=chapar
POSTGRES_PASSWORD=secret
# Apply pending DB migrations on startup (enable on a single instance only).
RUN_MIGRATIONS=false

# ── Redis (BullMQ) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://:secret@localhost:6379
REDIS_PASSWORD=secret

# ── Security ────────────────────────────────────────────────────────────────────
# SHA-256 (hex) hash of your API key. Clients send the raw key as the X-API-Key header.
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_KEY').digest('hex'))"
API_KEY_HASH=replace_with_sha256_hex_hash_of_your_api_key

# ── Rate Limiting ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Templates ──────────────────────────────────────────────────────────────────
# Optional directory of custom .hbs templates, searched BEFORE the built-ins.
# Mount a volume there to add/override templates without rebuilding the image,
# e.g. TEMPLATES_DIR=/templates with `-v ./my-templates:/templates:ro`.
# Edits are picked up on the next render — no restart needed.
TEMPLATES_DIR=

# ── KavehNegar (SMS) ───────────────────────────────────────────────────────────
KAVEHNEGAR_API_KEY=
# Comma-separated sender lines. First entry is the default; callers may choose
# any listed line per message via the `sender` field on POST /notify.
# Leave empty to always use the KavehNegar account's default line.
KAVEHNEGAR_LINES=10004346,30002225

# ── SMTP (Email) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Push Notifications ─────────────────────────────────────────────────────────
# Set to true to use Firebase FCM; false to use Redis Pub/Sub in-app notifications
FIREBASE_NOTIFICATION=false

# Firebase (required when FIREBASE_NOTIFICATION=true)
# Generate: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_CREDENTIALS_JSON=

# Redis Pub/Sub (required when FIREBASE_NOTIFICATION=false)
REDIS_PUBSUB_URL=redis://:secret@localhost:6379
REDIS_PUBSUB_CHANNEL_PREFIX=notifications
